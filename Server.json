/* ============================================================
   EBAY
============================================================ */

const EBAY_MARKETPLACES = {
  US: 'EBAY_US',
  GB: 'EBAY_GB',
  DE: 'EBAY_DE',
  FR: 'EBAY_FR',
  IT: 'EBAY_IT',
  ES: 'EBAY_ES',
  CA: 'EBAY_CA',
  AU: 'EBAY_AU'
};

function getEbayMarketplace(country) {
  const code =
    String(
      country || 'US'
    ).toUpperCase();

  return (
    EBAY_MARKETPLACES[code] ||
    'EBAY_US'
  );
}

let ebayTokenCache = {
  token: null,
  expiresAt: 0
};

async function getEbayToken() {
  if (
    ebayTokenCache.token &&
    ebayTokenCache.expiresAt >
      Date.now() + 60 * 1000
  ) {
    return ebayTokenCache.token;
  }

  const clientId =
    process.env.EBAY_CLIENT_ID;

  const clientSecret =
    process.env.EBAY_CLIENT_SECRET;

  if (
    !clientId ||
    !clientSecret
  ) {
    return null;
  }

  const credentials =
    Buffer.from(
      `${clientId}:${clientSecret}`
    ).toString('base64');

  const response =
    await fetch(
      'https://api.ebay.com/identity/v1/oauth2/token',
      {
        method: 'POST',

        headers: {
          'Content-Type':
            'application/x-www-form-urlencoded',

          'Authorization':
            `Basic ${credentials}`
        },

        body:
          new URLSearchParams({
            grant_type:
              'client_credentials',

            scope:
              'https://api.ebay.com/oauth/api_scope'
          })
      }
    );

  const data =
    await response.json();

  if (!response.ok) {
    throw new Error(
      data?.error_description ||
      'Erreur token eBay'
    );
  }

  ebayTokenCache = {
    token:
      data.access_token,

    expiresAt:
      Date.now() +
      Number(
        data.expires_in || 7200
      ) * 1000
  };

  return ebayTokenCache.token;
}

async function ebaySearch({
  q,
  country,
  limit = 20
}) {
  const token =
    await getEbayToken();

  if (!token) {
    return null;
  }

  const marketplaceId =
    getEbayMarketplace(country);

  const url =
    new URL(
      'https://api.ebay.com/buy/browse/v1/item_summary/search'
    );

  url.searchParams.set(
    'q',
    q
  );

  url.searchParams.set(
    'limit',
    String(
      Math.min(
        Number(limit) || 20,
        50
      )
    )
  );

  const response =
    await fetch(
      url,
      {
        headers: {
          'Authorization':
            `Bearer ${token}`,

          'Content-Type':
            'application/json',

          'X-EBAY-C-MARKETPLACE-ID':
            marketplaceId
        }
      }
    );

  const data =
    await response.json();

  if (!response.ok) {
    throw new Error(
      data?.errors?.[0]?.message ||
      'Erreur recherche eBay'
    );
  }

  return data;
}

function applyMarkup(price) {
  const base =
    Number(price || 0);

  const markup =
    Number(
      process.env.PRICE_MARKUP || 6
    );

  return Number(
    (
      base +
      (
        Number.isFinite(markup)
          ? markup
          : 0
      )
    ).toFixed(2)
  );
}

function mapEbayItems(data) {
  const items =
    Array.isArray(
      data?.itemSummaries
    )
      ? data.itemSummaries
      : [];

  return items.map(
    (item, index) => {
      const basePrice =
        Number(
          item?.price?.value || 0
        );

      return {
        id:
          item.itemId ||
          `ebay-${index}`,

        name:
          item.title ||
          'Produit',

        category:
          'eBay',

        price:
          applyMarkup(basePrice),

        originalPrice:
          basePrice,

        rating:
          Number(
            item?.seller?.feedbackPercentage ||
            0
          ),

        sold:
          0,

        image:
          item?.image?.imageUrl ||
          '',

        description:
          item.shortDescription ||
          item.title ||
          '',

        itemUrl:
          item.itemWebUrl ||
          '',

        shipping:
          item?.shippingOptions?.[0]
            ?.shippingCost
            ?.value
            ? `Livraison ${item.shippingOptions[0].shippingCost.value}`
            : 'Livraison selon vendeur'
      };
    }
  );
}

app.get(
  '/api/catalog/search',
  async (req, res) => {
    try {
      const q =
        cleanString(
          req.query.q,
          300
        );

      const country =
        cleanString(
          req.query.country || 'US',
          10
        );

      if (!q) {
        return res.status(400).json({
          ok: false,
          error: 'Recherche vide'
        });
      }

      const data =
        await ebaySearch({
          q,
          country,
          limit:
            Number(
              req.query.limit || 20
            )
        });

      if (!data) {
        const products =
          readJSON(
            PRODUCTS_FILE,
            []
          );

        const filtered =
          products.filter(
            product =>
              String(
                product.name || ''
              )
                .toLowerCase()
                .includes(
                  q.toLowerCase()
                )
          );

        return res.json({
          ok: true,
          source: 'local',
          products: filtered
        });
      }

      return res.json({
        ok: true,
        source: 'ebay',
        products:
          mapEbayItems(data)
      });

    } catch (error) {
      console.error(
        'catalog/search:',
        error.message
      );

      return res.status(500).json({
        ok: false,
        error: error.message
      });
    }
  }
);

