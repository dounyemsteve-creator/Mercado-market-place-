async function runViewReminders() {
  if (
    !process.env.RESEND_API_KEY &&
    !process.env.SMTP_HOST
  ) {
    return;
  }

  const delayHours =
    Number(
      process.env.REMINDER_DELAY_HOURS || 24
    );

  const delayMs =
    delayHours *
    60 *
    60 *
    1000;

  const now =
    Date.now();

  const views =
    readJSON(
      VIEWS_FILE,
      []
    );

  let changed = false;

  for (
    const view of views
  ) {
    if (
      view.reminded ||
      view.purchased
    ) {
      continue;
    }

    const viewedAt =
      Date.parse(
        view.viewedAt
      );

    if (!Number.isFinite(viewedAt)) {
      continue;
    }

    if (
      now - viewedAt <
      delayMs
    ) {
      continue;
    }

    const email =
      cleanString(
        view.email,
        320
      ).toLowerCase();

    const product =
      view.product || {};

    if (
      !email ||
      !email.includes('@')
    ) {
      continue;
    }

    try {
      await sendEmail({
        to:
          email,

        subject:
          `Toujours intéressé(e) par ${product.name || 'ce produit'} ?`,

        text:
          `Vous avez récemment consulté ` +
          `${product.name || 'un produit'} sur MERCADO.`,

        html: `
          <div style="font-family:Arial,sans-serif">

            <h2>MERCADO</h2>

            ${
              product.image
                ? `
                  <img
                    src="${product.image}"
                    alt=""
                    style="max-width:300px"
                  />
                `
                : ''
            }

            <h3>
              ${product.name || 'Produit'}
            </h3>

            ${
              product.price != null
                ? `
                  <p>
                    Prix :
                    <strong>
                      ${Number(product.price).toFixed(2)}
                    </strong>
                  </p>
                `
                : ''
            }

            ${
              product.itemUrl
                ? `
                  <p>
                    <a href="${product.itemUrl}">
                      Voir le produit
                    </a>
                  </p>
                `
                : ''
            }

          </div>
        `
      });

      view.reminded = true;

      view.remindedAt =
        new Date().toISOString();

      changed = true;

    } catch (error) {
      console.error(
        'Reminder email:',
        error.message
      );
    }
  }

  if (changed) {
    writeJSON(
      VIEWS_FILE,
      views.slice(-500)
    );
  }
}

