function markViewedProductsAsPurchased(
  email,
  items
) {
  if (!email) {
    return;
  }

  const views =
    readJSON(
      VIEWS_FILE,
      []
    );

  const names =
    new Set(
      (items || [])
        .map(
          item =>
            cleanString(
              item.name,
              500
            )
        )
        .filter(Boolean)
    );

  for (
    const view of views
  ) {
    if (
      String(view.email || '')
        .toLowerCase() !==
      email.toLowerCase()
    ) {
      continue;
    }

    if (
      names.has(
        String(view.product?.name || '')
      )
    ) {
      view.purchased = true;
      view.reminded = true;
      view.purchasedAt =
        new Date().toISOString();
    }
  }

  writeJSON(
    VIEWS_FILE,
    views.slice(-500)
  );
}

