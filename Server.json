const REVIEWS_FILE =
  path.join(DATA_DIR, 'reviews.json');

const VIEWS_FILE =
  path.join(DATA_DIR, 'product-views.json');

const ORDERS_FILE =
  path.join(DATA_DIR, 'orders.json');

/* ============================================================
   OUTILS JSON
============================================================ */

function readJSON(file, fallback) {
  try {
    if (!fs.existsSync(file)) {
      return fallback;
    }

    return JSON.parse(
      fs.readFileSync(file, 'utf8')
    );
  } catch (error) {
    console.error(
      `Erreur lecture JSON ${file}:`,
      error.message
    );

    return fallback;
  }
}

function writeJSON(file, data) {
  try {
    fs.writeFileSync(
      file,
      JSON.stringify(data, null, 2),
      'utf8'
    );

    return true;
  } catch (error) {
    console.error(
      `Erreur écriture JSON ${file}:`,
      error.message
    );

    return false;
  }
}

function ensureJSONFile(file, fallback) {
  if (!fs.existsSync(file)) {
    writeJSON(file, fallback);
  }
}

ensureJSONFile(SUBSCRIBERS_FILE, []);
ensureJSONFile(PRODUCTS_FILE, []);
ensureJSONFile(REVIEWS_FILE, []);
ensureJSONFile(VIEWS_FILE, []);
ensureJSONFile(ORDERS_FILE, []);

/* ============================================================
   FONCTIONS UTILITAIRES
============================================================ */

function cleanString(value, maxLength = 500) {
  return String(value ?? '')
    .trim()
    .slice(0, maxLength);
}

function generateOrderId() {
  const random = crypto
    .randomBytes(5)
    .toString('hex')
    .toUpperCase();

  return `MERCADO-${Date.now()}-${random}`;
}

function getPublicBaseUrl() {
  return String(
    process.env.PUBLIC_BASE_URL || ''
  )
    .trim()
    .replace(/\/+$/, '');
}

function isAdmin(req) {
  const expected =
    process.env.ADMIN_KEY || '';

  if (!expected) {
    return false;
  }

  const supplied =
    req.headers['x-admin-key'] ||
    req.headers['x-admin-key'.toLowerCase()] ||
    '';

  return supplied === expected;
}

