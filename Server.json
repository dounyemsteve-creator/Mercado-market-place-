/* ============================================================
   EMAIL
============================================================ */

async function sendEmail({
  to,
  subject,
  html,
  text
}) {
  const recipient = cleanString(to, 320);

  if (!recipient) {
    throw new Error(
      'Destinataire email manquant'
    );
  }

  /*
   * ----------------------------------------------------------
   * RESEND
   * ----------------------------------------------------------
   */

  if (process.env.RESEND_API_KEY) {
    const from =
      process.env.RESEND_FROM ||
      'MERCADO <onboarding@resend.dev>';

    const response = await fetch(
      'https://api.resend.com/emails',
      {
        method: 'POST',

        headers: {
          'Authorization':
            `Bearer ${process.env.RESEND_API_KEY}`,

          'Content-Type':
            'application/json'
        },

        body: JSON.stringify({
          from,
          to: [recipient],
          subject,
          html,
          text
        })
      }
    );

    const data =
      await response.json();

    if (!response.ok) {
      throw new Error(
        data?.message ||
        'Erreur Resend'
      );
    }

    return {
      provider: 'resend',
      id: data?.id || null
    };
  }

  /*
   * ----------------------------------------------------------
   * SMTP
   * ----------------------------------------------------------
   */

  if (
    process.env.SMTP_HOST &&
    process.env.SMTP_USER &&
    process.env.SMTP_PASS
  ) {
    const transporter =
      nodemailer.createTransport({
        host: process.env.SMTP_HOST,

        port: Number(
          process.env.SMTP_PORT || 587
        ),

        secure:
          String(
            process.env.SMTP_SECURE || ''
          ).toLowerCase() === 'true',

        auth: {
          user:
            process.env.SMTP_USER,

          pass:
            process.env.SMTP_PASS
        }
      });

    const from =
      process.env.SMTP_FROM ||
      process.env.SMTP_USER;

    const info =
      await transporter.sendMail({
        from,
        to: recipient,
        subject,
        text,
        html
      });

    return {
      provider: 'smtp',
      id: info?.messageId || null
    };
  }

  throw new Error(
    'Aucun service email configuré'
  );
}

/* ============================================================
   VÉRIFICATION EMAIL
============================================================ */

const emailCodes = new Map();

app.post(
  '/api/email/send',
  async (req, res) => {
    try {
      const email =
        cleanString(
          req.body?.email,
          320
        ).toLowerCase();

      if (!email || !email.includes('@')) {
        return res.status(400).json({
          ok: false,
          error: 'Email invalide'
        });
      }

      const code =
        String(
          Math.floor(
            1000 +
            Math.random() * 9000
          )
        );

      const expiresAt =
        Date.now() +
        10 * 60 * 1000;

      emailCodes.set(
        email,
        {
          code,
          expiresAt
        }
      );

      await sendEmail({
        to: email,

        subject:
          'Votre code de vérification MERCADO',

        text:
          `Votre code MERCADO est ${code}. ` +
          `Il expire dans 10 minutes.`,

        html: `
          <div style="font-family:Arial,sans-serif">
            <h2>MERCADO</h2>
            <p>Votre code de vérification :</p>
            <p style="font-size:32px;font-weight:bold">
              ${code}
            </p>
            <p>Ce code expire dans 10 minutes.</p>
          </div>
        `
      });

      return res.json({
        ok: true
      });

    } catch (error) {
      console.error(
        'email/send:',
        error.message
      );

      return res.status(500).json({
        ok: false,
        error: error.message
      });
    }
  }
);

app.post(
  '/api/email/verify',
  (req, res) => {
    const email =
      cleanString(
        req.body?.email,
        320
      ).toLowerCase();

    const code =
      cleanString(
        req.body?.code,
        20
      );

    const saved =
      emailCodes.get(email);

    if (!saved) {
      return res.status(400).json({
        ok: false,
        error: 'Code introuvable ou expiré'
      });
    }

    if (
      Date.now() >
      saved.expiresAt
    ) {
      emailCodes.delete(email);

      return res.status(400).json({
        ok: false,
        error: 'Code expiré'
      });
    }

    if (saved.code !== code) {
      return res.status(400).json({
        ok: false,
        error: 'Code incorrect'
      });
    }

    emailCodes.delete(email);

    return res.json({
      ok: true,
      verified: true
    });
  }
);

/* ============================================================
   NOTIFICATIONS ADMIN
============================================================ */

async function sendTelegram(message) {
  const token =
    process.env.TELEGRAM_BOT_TOKEN;

  const chatId =
    process.env.TELEGRAM_CHAT_ID;

  if (!token || !chatId) {
    return false;
  }

  const response =
    await fetch(
      `https://api.telegram.org/bot${token}/sendMessage`,
      {
        method: 'POST',

        headers: {
          'Content-Type':
            'application/json'
        },

        body: JSON.stringify({
          chat_id: chatId,
          text: message
        })
      }
    );

  if (!response.ok) {
    throw new Error(
      'Telegram notification failed'
    );
  }

  return true;
}

async function sendMessenger(message) {
  const token =
    process.env.FB_PAGE_ACCESS_TOKEN;

  const psid =
    process.env.FB_ADMIN_PSID;

  if (!token || !psid) {
    return false;
  }

  const response =
    await fetch(
      'https://graph.facebook.com/v19.0/me/messages',
      {
        method: 'POST',

        headers: {
          'Content-Type':
            'application/json'
        },

        body: JSON.stringify({
          recipient: {
            id: psid
          },

          message: {
            text: message
          },

          access_token: token
        })
      }
    );

  if (!response.ok) {
    throw new Error(
      'Messenger notification failed'
    );
  }

  return true;
}

async function sendWhatsApp(message) {
  const sid =
    process.env.TWILIO_ACCOUNT_SID;

  const auth =
    process.env.TWILIO_AUTH_TOKEN;

  const from =
    process.env.TWILIO_WHATSAPP_FROM;

  const to =
    process.env.WHATSAPP_TO;

  if (
    !sid ||
    !auth ||
    !from ||
    !to
  ) {
    return false;
  }

  const credentials =
    Buffer.from(
      `${sid}:${auth}`
    ).toString('base64');

  const body =
    new URLSearchParams({
      From: from,
      To: to,
      Body: message
    });

  const response =
    await fetch(
      `https://api.twilio.com/2010-04-01/Accounts/${sid}/Messages.json`,
      {
        method: 'POST',

        headers: {
          'Authorization':
            `Basic ${credentials}`,

          'Content-Type':
            'application/x-www-form-urlencoded'
        },

        body
      }
    );

  if (!response.ok) {
    throw new Error(
      'WhatsApp/Twilio notification failed'
    );
  }

  return true;
}

async function sendAdminMessage(message) {
  /*
   * Priorité :
   * Telegram
   * puis Messenger
   * puis WhatsApp
   */

  try {
    if (
      process.env.TELEGRAM_BOT_TOKEN &&
      process.env.TELEGRAM_CHAT_ID
    ) {
      await sendTelegram(message);
      return 'telegram';
    }
  } catch (error) {
    console.error(
      'Telegram:',
      error.message
    );
  }

  try {
    if (
      process.env.FB_PAGE_ACCESS_TOKEN &&
      process.env.FB_ADMIN_PSID
    ) {
      await sendMessenger(message);
      return 'messenger';
    }
  } catch (error) {
    console.error(
      'Messenger:',
      error.message
    );
  }

  try {
    if (
      process.env.TWILIO_ACCOUNT_SID &&
      process.env.TWILIO_AUTH_TOKEN &&
      process.env.TWILIO_WHATSAPP_FROM &&
      process.env.WHATSAPP_TO
    ) {
      await sendWhatsApp(message);
      return 'whatsapp';
    }
  } catch (error) {
    console.error(
      'WhatsApp:',
      error.message
    );
  }

  return null;
}

/* ============================================================
   COMMANDES
============================================================ */

function formatOrderMessage(order) {
  const lines = [];

  lines.push(
    '🛍️ NOUVELLE COMMANDE MERCADO'
  );

  lines.push(
    `Commande: ${order.orderId}`
  );

  lines.push(
    `Statut: ${order.status || 'pending'}`
  );

  lines.push(
    `Paiement: ${order.paymentMethod || 'non précisé'}`
  );

  lines.push(
    `Total: ${Number(order.total || 0).toFixed(2)} EUR`
  );

  lines.push('');

  lines.push('CLIENT');

  lines.push(
    `Nom: ${order.customer?.name || '-'}`
  );

  lines.push(
    `Email: ${order.customer?.email || '-'}`
  );

  lines.push(
    `Téléphone: ${order.customer?.phone || '-'}`
  );

  lines.push(
    `Adresse: ${order.customer?.address || '-'}`
  );

  lines.push('');

  lines.push('ARTICLES');

  for (
    const item of order.items || []
  ) {
    lines.push(
      `- ${item.name || 'Produit'}`
    );

    lines.push(
      `  Prix: ${Number(item.price || 0).toFixed(2)} EUR`
    );

    lines.push(
      `  Quantité: ${Number(item.qty || item.quantity || 1)}`
    );

    if (item.desc) {
      lines.push(
        `  ${item.desc}`
      );
    }

    if (item.sourceUrl || item.itemUrl) {
      lines.push(
        `  Source: ${item.sourceUrl || item.itemUrl}`
      );
    }
  }

  return lines.join('\n');
}

/* ============================================================
   CRÉER / ENREGISTRER UNE COMMANDE
============================================================ */

app.post(
  '/api/order',
  async (req, res) => {
    try {
      const body =
        req.body || {};

      const orderId =
        cleanString(
          body.orderId ||
          generateOrderId(),
          150
        );

      const items =
        Array.isArray(body.items)
          ? body.items
          : [];

      if (!items.length) {
        return res.status(400).json({
          ok: false,
          error: 'Commande vide'
        });
      }

      const total =
        Number(body.total || 0);

      if (
        !Number.isFinite(total) ||
        total < 0
      ) {
        return res.status(400).json({
          ok: false,
          error: 'Total invalide'
        });
      }

      const order = {
        orderId,

        items,

        customer:
          body.customer || {},

        paymentMethod:
          cleanString(
            body.paymentMethod ||
            'unknown',
            100
          ),

        total,

        status:
          cleanString(
            body.status ||
            'pending',
            50
          ),

        createdAt:
          new Date().toISOString()
      };

      const orders =
        readJSON(
          ORDERS_FILE,
          []
        );

      const existingIndex =
        orders.findIndex(
          item =>
            item.orderId === orderId
        );

      if (existingIndex >= 0) {
        orders[existingIndex] = {
          ...orders[existingIndex],
          ...order,
          updatedAt:
            new Date().toISOString()
        };
      } else {
        orders.push(order);
      }

      writeJSON(
        ORDERS_FILE,
        orders
      );

      const message =
        formatOrderMessage(order);

      await sendAdminMessage(
        message
      );

      /*
       * Confirmation client.
       */

      const customerEmail =
        cleanString(
          order.customer?.email,
          320
        ).toLowerCase();

      if (
        customerEmail &&
        customerEmail.includes('@')
      ) {
        try {
          await sendEmail({
            to: customerEmail,

            subject:
              `Commande MERCADO ${order.orderId}`,

            text:
              `Votre commande ${order.orderId} ` +
              `a été enregistrée. ` +
              `Total: ${Number(order.total).toFixed(2)} EUR.`,

            html: `
              <div style="font-family:Arial,sans-serif">
                <h2>MERCADO</h2>
                <p>
                  Votre commande
                  <strong>${order.orderId}</strong>
                  a été enregistrée.
                </p>

                <p>
                  Total :
                  <strong>
                    ${Number(order.total).toFixed(2)} EUR
                  </strong>
                </p>

                <p>
                  Statut :
                  <strong>${order.status}</strong>
                </p>
              </div>
            `
          });
        } catch (emailError) {
          console.error(
            'Customer confirmation email:',
            emailError.message
          );
        }
      }

      /*
       * Marquer les produits consultés comme achetés.
       */

      markViewedProductsAsPurchased(
        customerEmail,
        items
      );

      return res.json({
        ok: true,
        orderId
      });

    } catch (error) {
      console.error(
        'api/order:',
        error.message
      );

      return res.status(500).json({
        ok: false,
        error: error.message
      });
    }
  }
);

/* ============================================================
   GATEPAY.TO
============================================================ */

/*
 * IMPORTANT :
 *
 * GatePay.to indique publiquement que son endpoint de paiement
 * est :
 *
 * https://api.gatepay.to/pay.php
 *
 * et que l'intégration utilise notamment :
 *
 * wallet
 * amount
 * currency
 * callback_url
 *
 * Aucun COINGATE_API_TOKEN n'est utilisé ici.
 */

app.post(
  '/api/payment/gatepay',
  async (req, res) => {
    try {
      const order =
        req.body || {};

      const wallet =
        cleanString(
          process.env.GATEPAY_WALLET_ADDRESS,
          300
        );

      const publicBaseUrl =
        getPublicBaseUrl();

      if (!wallet) {
        return res.status(500).json({
          ok: false,
          error:
            'GATEPAY_WALLET_ADDRESS non configuré'
        });
      }

      if (!publicBaseUrl) {
        return res.status(500).json({
          ok: false,
          error:
            'PUBLIC_BASE_URL non configuré'
        });
      }

      const total =
        Number(order.total);

      if (
        !Number.isFinite(total) ||
        total <= 0
      ) {
        return res.status(400).json({
          ok: false,
          error:
            'Montant de paiement invalide'
        });
      }

      const orderId =
        cleanString(
          order.orderId ||
          generateOrderId(),
          150
        );

      const callbackUrl =
        `${publicBaseUrl}/api/payment/gatepay/callback`;

      const payload = {
        wallet,

        amount:
          total.toFixed(2),

        currency:
          'EUR',

        callback_url:
          callbackUrl
      };

      console.log(
        'Création paiement GatePay:',
        {
          orderId,
          amount: payload.amount,
          currency: payload.currency
        }
      );

      const response =
        await fetch(
          'https://api.gatepay.to/pay.php',
          {
            method: 'POST',

            headers: {
              'Content-Type':
                'application/json',

              'Accept':
                'application/json'
            },

            body:
              JSON.stringify(payload)
          }
        );

      const raw =
        await response.text();

      let data;

      try {
        data =
          raw
            ? JSON.parse(raw)
            : {};
      } catch {
        data = {
          raw
        };
      }

      if (!response.ok) {
        console.error(
          'GatePay API error:',
          response.status,
          data
        );

        return res.status(502).json({
          ok: false,

          error:
            data?.message ||
            data?.error ||
            'Erreur GatePay'
        });
      }

      const paymentUrl =
        data?.payment_url ||
        data?.checkout_url ||
        data?.url ||
        data?.checkout ||
        data?.payment?.url ||
        data?.data?.payment_url ||
        data?.data?.checkout_url ||
        data?.data?.url ||
        null;

      if (!paymentUrl) {
        console.error(
          'Réponse GatePay sans URL:',
          data
        );

        return res.status(502).json({
          ok: false,

          error:
            'GatePay n’a pas retourné d’URL de paiement',

          response:
            data
        });
      }

      /*
       * Enregistrer la commande comme pending.
       */

      const orders =
        readJSON(
          ORDERS_FILE,
          []
        );

      const existingIndex =
        orders.findIndex(
          item =>
            item.orderId === orderId
        );

      const paymentOrder = {
        orderId,

        items:
          Array.isArray(order.items)
            ? order.items
            : [],

        customer:
          order.customer || {},

        paymentMethod:
          'gatepay',

        total,

        status:
          'pending',

        gatepayOrderId:
          data?.order_id ||
          data?.id ||
          data?.data?.order_id ||
          data?.data?.id ||
          null,

        paymentUrl,

        createdAt:
          new Date().toISOString(),

        updatedAt:
          new Date().toISOString()
      };

      if (existingIndex >= 0) {
        orders[existingIndex] = {
          ...orders[existingIndex],
          ...paymentOrder
        };
      } else {
        orders.push(
          paymentOrder
        );
      }

      writeJSON(
        ORDERS_FILE,
        orders
      );

      return res.json({
        ok: true,

        order_id:
          orderId,

        payment_url:
          paymentUrl,

        checkout_url:
          paymentUrl,

        gatepay_order_id:
          paymentOrder.gatepayOrderId
      });

    } catch (error) {
      console.error(
        'GatePay payment error:',
        error
      );

      return res.status(500).json({
        ok: false,

        error:
          error?.message ||
          'Erreur serveur GatePay'
      });
    }
  }
);

/* ============================================================
   GATEPAY CALLBACK / WEBHOOK
============================================================ */

/*
 * GatePay indique qu'un webhook/callback est envoyé après
 * vérification du paiement.
 *
 * Le format exact des champs du callback doit correspondre
 * à celui réellement envoyé par GatePay.
 *
 * Le serveur ci-dessous accepte plusieurs noms courants
 * mais ne considère PAS une simple requête comme paiement
 * confirmé sans indication de statut.
 */

app.all(
  '/api/payment/gatepay/callback',
  (req, res) => {

    try {
      const body =
        req.body || {};

      const query =
        req.query || {};

      console.log(
        '========== GATEPAY CALLBACK =========='
      );

      console.log(
        'Method:',
        req.method
      );

      console.log(
        'Body:',
        body
      );

      console.log(
        'Query:',
        query
      );

      console.log(
        '======================================='
      );

      const data = {
        ...query,
        ...body
      };

      /*
       * Recherche de l'identifiant de commande.
       */

      const orderId =
        data.order_id ||
        data.orderId ||
        data.merchant_order_id ||
        data.merchant_order ||
        data.reference ||
        data.order?.id ||
        data.data?.order_id ||
        data.data?.orderId ||
        null;

      /*
       * Recherche du statut.
       */

      const statusRaw =
        data.status ||
        data.payment_status ||
        data.transaction_status ||
        data.state ||
        data.data?.status ||
        data.data?.payment_status ||
        '';

      const status =
        String(
          statusRaw
        ).toLowerCase();

      /*
       * Statuts qui peuvent représenter une confirmation.
       *
       * Ceci doit être aligné avec la documentation
       * exacte de GatePay avant production.
       */

      const paidStatuses = [
        'paid',
        'completed',
        'complete',
        'confirmed',
        'success',
        'successful',
        'succeeded'
      ];

      const failedStatuses = [
        'failed',
        'cancelled',
        'canceled',
        'expired',
        'rejected'
      ];

      if (!orderId) {
        console.warn(
          'GatePay callback reçu sans orderId'
        );

        return res.status(200).json({
          ok: true,
          received: true
        });
      }

      const orders =
        readJSON(
          ORDERS_FILE,
          []
        );

      const index =
        orders.findIndex(
          order =>
            String(order.orderId) ===
            String(orderId)
        );

      if (index < 0) {
        console.warn(
          'GatePay callback: commande inconnue',
          orderId
        );

        return res.status(200).json({
          ok: true,
          received: true
        });
      }

      const order =
        orders[index];

      /*
       * ------------------------------------------------------
       * MONTANT
       * ------------------------------------------------------
       *
       * Si GatePay fournit un montant dans le callback,
       * on compare avec le montant de la commande.
       */

      const callbackAmount =
        Number(
          data.amount ??
          data.paid_amount ??
          data.received_amount ??
          data.payment?.amount ??
          data.data?.amount
        );

      const expectedAmount =
        Number(order.total || 0);

      const amountProvided =
        Number.isFinite(
          callbackAmount
        );

      const amountMatches =
        !amountProvided ||
        Math.abs(
          callbackAmount -
          expectedAmount
        ) < 0.01;

      if (
        paidStatuses.includes(status)
      ) {
        if (!amountMatches) {
          console.error(
            'GatePay: montant callback différent',
            {
              orderId,
              expectedAmount,
              callbackAmount
            }
          );

          return res.status(200).json({
            ok: true,
            received: true
          });
        }

        orders[index] = {
          ...order,

          status:
            'paid',

          paidAt:
            order.paidAt ||
            new Date().toISOString(),

          gatepayCallback:
            data,

          updatedAt:
            new Date().toISOString()
        };

        writeJSON(
          ORDERS_FILE,
          orders
        );

        console.log(
          `Commande ${orderId} marquée PAID`
        );

        /*
         * Notification admin.
         */

        try {
          await sendAdminMessage(
            [
              '✅ PAIEMENT GATEPAY CONFIRMÉ',
              '',
              `Commande: ${orderId}`,
              `Montant: ${expectedAmount.toFixed(2)} EUR`,
              `Client: ${order.customer?.name || '-'}`,
              `Email: ${order.customer?.email || '-'}`
            ].join('\n')
          );
        } catch (error) {
          console.error(
            'Notification paiement:',
            error.message
          );
        }

        /*
         * Email client.
         */

        const customerEmail =
          cleanString(
            order.customer?.email,
            320
          ).toLowerCase();

        if (
          customerEmail &&
          customerEmail.includes('@')
        ) {
          try {
            await sendEmail({
              to:
                customerEmail,

              subject:
                `Paiement confirmé — ${orderId}`,

              text:
                `Votre paiement pour la commande ` +
                `${orderId} a été confirmé.`,

              html: `
                <div style="font-family:Arial,sans-serif">
                  <h2>MERCADO</h2>

                  <p>
                    Votre paiement a été confirmé.
                  </p>

                  <p>
                    Commande :
                    <strong>${orderId}</strong>
                  </p>

                  <p>
                    Montant :
                    <strong>
                      ${expectedAmount.toFixed(2)} EUR
                    </strong>
                  </p>
                </div>
              `
            });
          } catch (error) {
            console.error(
              'Email paiement confirmé:',
              error.message
            );
          }
        }
      }

      if (
        failedStatuses.includes(status)
      ) {
        orders[index] = {
          ...order,

          status:
            'failed',

          gatepayCallback:
            data,

          updatedAt:
            new Date().toISOString()
        };

        writeJSON(
          ORDERS_FILE,
          orders
        );

        console.log(
          `Commande ${orderId} marquée FAILED`
        );
      }

      return res.status(200).json({
        ok: true,
        received: true
      });

    } catch (error) {
      console.error(
        'GatePay callback error:',
        error
      );

      /*
       * On répond 200 pour éviter des répétitions
       * inutiles si GatePay considère toute erreur
       * comme un webhook non reçu.
       */

      return res.status(200).json({
        ok: false,
        received: true
      });
    }
  }
);

